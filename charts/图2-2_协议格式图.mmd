%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#2196F3', 'primaryTextColor': 'white', 'primaryBorderColor': '#1565C0', 'lineColor': '#333333', 'secondaryColor': '#FF9800', 'tertiaryColor': '#E3F2FD'}}}%%

graph TB
    subgraph 协议头部结构 [15字节协议头部]
        direction TB

        subgraph 字节0-1 [字节 0-1 (2字节)]
            M[Magic<br/>0xF1F2]
        end

        subgraph 字节2 [字节 2 (1字节)]
            V[Version<br/>0x01]
        end

        subgraph 字节3 [字节 3 (1字节)]
            T[Type<br/>0=请求<br/>1=响应<br/>2=数据]
        end

        subgraph 字节4 [字节 4 (1字节)]
            C[Command<br/>0x01=mkdir<br/>0x02=rename<br/>0x10=upload<br/>0x11=download<br/>0x12=list<br/>0x20=delete]
        end

        subgraph 字节5-6 [字节 5-6 (2字节)]
            ST[Status Code<br/>0x0000=OK<br/>0x0001=NOT_FOUND<br/>0x0002=EXISTS<br/>...]
        end

        subgraph 字节7-10 [字节 7-10 (4字节)]
            PL[Payload Length<br/>最大 4GB]
        end

        subgraph 字节11-14 [字节 11-14 (4字节)]
            CS[Checksum / CRC32<br/>校验和]
        end
    end

    subgraph 负载部分 [变长负载]
        P[Payload<br/>变长数据]
    end

    协议头部结构 --> 负载部分

